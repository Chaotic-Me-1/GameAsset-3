  m_Script: {fileID: 11500000, guid: e9da8316cca96434b89229eaa553826f, type: 3}
  m_Name: LOOP2_BabyDialogue
  m_EditorClassIdentifier: 
  promptText: "The baby in front of you starts to cry out loud. The child\u2019s
    crying is ringing in your ears, and the parents don\u2019t look like they\u2019re
    doing anything..."
  promptVoiceLine:
    Guid:
      Data1: 0
      Data2: 0
      Data3: 0
      Data4: 0
    Path: 
  options:
  - optionText: Make funny faces
    karmaImpact: 5
    reactionText: "The baby turns toward you, and you start making funny faces. The
      child stops crying, observing you for a second before breaking out into a lovely
      laugh. As it looks back at its mother, it calms down, ready to drift back to
      sleep.  Feeling relieved that you won\u2019t have to hear crying for hours
      to come, something about the sound feels familiar. The baby's cries begin to
      replay in your head..."
    playerVoiceLine:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    npcReactionVoiceLine:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    followUpDialogue: {fileID: 0}
    objectIDsToEnable: []
  - optionText: Yell back
    karmaImpact: -5
    reactionText: "You yell at the baby and its parents. \"Waaaaa!!! Waaaaa!!! Make
      that thing shut up!\". The baby just starts to cry even louder. The father
      turns in your direction, yelling at you. \"What is wrong with you?!\". Your
      face turns red and you yell back at the man \"What is wrong with me? What's
      wrong with you?! Make that thing shut up!\"  The mans face turns to a look
      of defeat. \"We've been trying all day! He's fussy! Yelling won\u2019t help!\"
      You lean back into your chair \"I don't care. Just make it stop!\". The father
      has clearly had enough of you. \"You better shut it. You're the worst!\" -
      The baby's cries grow even louder, ringing in your ears. There's something
      about it..."
    playerVoiceLine:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    npcReactionVoiceLine:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    followUpDialogue: {fileID: 0}
    objectIDsToEnable: []
  - optionText: Say nothing
    karmaImpact: 0
    reactionText: You stay quiet as this is a problem for the parents not you, but
      there is something about that crying that reminds you of something.
    playerVoiceLine:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
